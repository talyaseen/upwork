# {{ ansible_managed }}
# Hardened sshd drop-in for edge-01. Overrides /etc/ssh/sshd_config and
# any earlier-sorted drop-in. Managed by the `hardening` Ansible role - do not edit
# by hand. (OpenSSH 9.x only supports protocol 2; the removed `Protocol` directive
# is intentionally omitted - specifying it aborts sshd on modern OpenSSH.)

# --- Authentication ---
PubkeyAuthentication yes
{% if hardening_ssh_disable_password | bool %}
PasswordAuthentication no
ChallengeResponseAuthentication no
KbdInteractiveAuthentication no
AuthenticationMethods publickey
{% else %}
# Bootstrap phase: password still permitted until a key is verified.
PasswordAuthentication yes
KbdInteractiveAuthentication yes
{% endif %}
PermitEmptyPasswords no
PermitRootLogin {{ hardening_ssh_permit_root_login }}
AllowUsers {{ hardening_ssh_allow_users | join(' ') }}
MaxAuthTries {{ hardening_ssh_max_auth_tries }}
LoginGraceTime {{ hardening_ssh_login_grace_time }}
MaxSessions {{ hardening_ssh_max_sessions }}

# --- Idle / session ---
ClientAliveInterval {{ hardening_ssh_client_alive_interval }}
ClientAliveCountMax {{ hardening_ssh_client_alive_count_max }}
TCPKeepAlive yes

# --- Forwarding / surface reduction ---
X11Forwarding {{ hardening_ssh_x11_forwarding }}
AllowTcpForwarding {{ hardening_ssh_allow_tcp_forwarding }}
AllowAgentForwarding {{ hardening_ssh_allow_agent_forwarding }}
AllowStreamLocalForwarding no
GatewayPorts no
PermitTunnel no
PermitUserEnvironment no
PrintLastLog yes

# --- Strong crypto (modern OpenSSH) ---
KexAlgorithms {{ hardening_ssh_kex | join(',') }}
Ciphers {{ hardening_ssh_ciphers | join(',') }}
MACs {{ hardening_ssh_macs | join(',') }}

{% if hardening_manage_motd_banner | bool %}
# --- Pre-auth banner ---
Banner /etc/issue.net
{% endif %}
