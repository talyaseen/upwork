// {{ ansible_managed }}
// Managed by the hardening role. Applies SECURITY updates automatically.

Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}";
    "${distro_id}:${distro_codename}-security";
    "${distro_id}ESMApps:${distro_codename}-apps-security";
    "${distro_id}ESM:${distro_codename}-infra-security";
};

// Never auto-upgrade these (none by default).
Unattended-Upgrade::Package-Blacklist {
};

Unattended-Upgrade::AutoFixInterruptedDpkg "true";
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// Controlled reboot policy.
Unattended-Upgrade::Automatic-Reboot "{{ 'true' if hardening_unattended_auto_reboot | bool else 'false' }}";
{% if hardening_unattended_auto_reboot | bool %}
Unattended-Upgrade::Automatic-Reboot-WithUsers "false";
Unattended-Upgrade::Automatic-Reboot-Time "{{ hardening_unattended_auto_reboot_time }}";
{% endif %}

// Send no mail by default (no MTA on this box).
Unattended-Upgrade::Mail "";
Unattended-Upgrade::SyslogEnable "true";
