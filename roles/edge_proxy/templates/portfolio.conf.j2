# Managed by Ansible (roles/edge_proxy). APEX PORTFOLIO vhost.
#
# example.com + www.example.com -> a PURE STATIC portfolio. No /api, no
# hub connection at all. The hotel site etc. are only LINKED from here (hosted
# elsewhere, e.g. Vercel).
#
# Public TLS is terminated by Cloudflare; THIS cert is the Cloudflare ORIGIN cert
# for the Cloudflare -> edge hop ("Full strict"). Authenticated Origin Pulls
# means only Cloudflare can reach edge:443.

server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }} {{ www_fqdn }};
    return 301 https://$host$request_uri;
}

server {
    # nginx < 1.25.1 (box has 1.24.0) has no standalone `http2 on;` directive -
    # enable HTTP/2 on the listen line for backward compatibility.
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name {{ domain }} {{ www_fqdn }};

    ssl_certificate     {{ origin_cert_path }};
    ssl_certificate_key {{ origin_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

{% if aop_enabled | default(true) %}
    # Authenticated Origin Pulls: only Cloudflare's client cert is accepted.
    # Per-hostname AOP -> our custom CA; zone AOP -> Cloudflare's global CA.
    ssl_client_certificate {{ aop_trust_path }};
    ssl_verify_client on;
{% endif %}

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css text/javascript application/javascript
               application/json image/svg+xml font/woff2;

    root {{ portfolio_web_root }};
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
