# Copy to .env and adjust. Nothing here is secret by default; you MUST set a
# strong JWT_SECRET in any real deployment.

# --- API metadata ---
APP_NAME="AI-First Semantic Search and Q&A API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"

# --- Security ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="change-me-in-production-this-is-only-a-local-default"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (async SQLAlchemy URL) ---
DATABASE_URL="sqlite+aiosqlite:///./ai_search.db"

# --- Embedding backend ---
# "sentence-transformers" = real local model (default for the app).
# "hash"                  = deterministic offline embedder (used by tests).
EMBEDDING_BACKEND="sentence-transformers"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
HASH_EMBEDDING_DIM=384

# --- Chunking ---
CHUNK_SIZE_WORDS=90
CHUNK_OVERLAP_WORDS=20

# --- Retrieval ---
DEFAULT_SEARCH_LIMIT=5
MAX_SEARCH_LIMIT=50
ASK_TOP_K=3
# How many corpus chunks the /chat RAG endpoint retrieves as grounding context.
CHAT_TOP_K=4

# --- Generative LLM for /chat (RAG) - GPU-ONLY ---
# Generation runs on LOCAL models only (no paid external API). The demo serves
# ONLY the GPU 7B via vLLM. There is NO CPU fallback: when the GPU is unavailable
# (serving training, or yielded) the demo reports OFFLINE rather than answering
# with a weaker, more easily jailbroken model.
#
# LLM backend:
#   "openjarvis" (default) - in-process OpenJarvis engine API (vLLM on GPU).
#   "openai"               - plain OpenAI-compatible client (lighter transport).
#   "fake"                 - deterministic offline client (the test suite).
LLM_BACKEND="openjarvis"

# The GPU 7B served by vLLM (the only model).
OPENAI_BASE_URL="http://localhost:8000/v1"
OPENAI_API_KEY="openjarvis"      # any non-empty string; unused for local
OPENAI_MODEL="qwen2.5:7b-instruct"

# OpenJarvis vLLM (GPU) engine host (used when LLM_BACKEND=openjarvis).
OPENJARVIS_VLLM_HOST="http://localhost:8000"

# --- OpenJarvis isolation (hard-separate this PUBLIC demo) ---
# Demo-only OpenJarvis home (config/memory/traces/telemetry/learning/vault).
# NEVER the shared ~/.openjarvis (used by other OpenJarvis instances).
OPENJARVIS_HOME="/run/openjarvis-demo"
OPENJARVIS_HOME_FALLBACK="./.openjarvis-demo"   # used if /run is not writable

# --- Self-learning (PUBLIC-SAFE, per-session, human-in-the-loop) ---
# Logs sanitized per-request traces (metadata only, never raw text) and derives
# improvement PROPOSALS. NEVER auto-applies anything; proposals need operator
# approval. Per-session + ephemeral, so public input cannot poison global state.
LEARNING_ENABLED=true
LEARNING_MAX_SESSIONS=500
LEARNING_MAX_TRACES_PER_SESSION=50
LEARNING_SESSION_TTL_SECONDS=3600.0

# Generation controls:
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
# Repetition guard (2026-07-01 incident fix): discourages the model from
# looping on its own output. ~1.1-1.3 is the commonly recommended range for
# vLLM's native repetition_penalty; 1.15 is a good default at low temperature.
LLM_REPETITION_PENALTY=1.15
LLM_REQUEST_TIMEOUT=180.0

# Default /chat model when the request does not pick one. "auto" = GPU-when-idle
# else CPU. Any catalog model id (see GET /models) also works.
DEFAULT_CHAT_MODEL="auto"

# --- GPU-idle router (per-request start gate) ---
# Before each request the router reads nvidia-smi (short TTL cache). FAIL SAFE:
# any error/timeout/missing tool => CPU. Never contends with training.
GPU_UTIL_IDLE_PCT=10
GPU_MEM_IDLE_MB=1000
GPU_CHECK_TTL_SECONDS=12.0
GPU_HYSTERESIS_COUNT=2
GPU_NVIDIA_SMI_TIMEOUT=4.0
GPU_NVIDIA_SMI_PATH="nvidia-smi"
# Per-GPU VRAM (MiB) at/under which usage is assumed to be OUR OWN vLLM. A healthy
# demo vLLM owns the GPU VRAM, so the serve gate is health + lock, not "GPU empty".
# A non-demo (training) process pushes a card over this ceiling (namespace-robust;
# nvidia-smi reports host PIDs an LXC cannot match). Tune to the GPU (T4 7B ~13 GiB).
GPU_DEMO_MEM_CEILING_MB=14336

# --- Dynamic GPU preemption (background monitor) ---
# Yields the GPU to training INSTANTLY (drops the GPU model, releases VRAM,
# migrates in-flight requests to CPU, routes new requests to CPU until idle).
GPU_MONITOR_ENABLED=true
GPU_MONITOR_INTERVAL_SECONDS=3.0

# --- GPU-yield lock file (manual "get off GPU" override) ---
# If this file EXISTS, every request is forced to CPU regardless of nvidia-smi,
# and any in-flight GPU request migrates to CPU. The backend owns it (the admin
# endpoints create/remove it). On /run (tmpfs) it clears on reboot, which is OK.
# Create the dir via the backend's systemd RuntimeDirectory=openjarvis.
GPU_YIELD_LOCK_FILE="/run/openjarvis/gpu_off.lock"

# --- Admin access (internal-only GPU lock control) - THREE layers ---
# /api/admin/* is gated by (1) the REAL socket peer IP in these CIDRs AND any
# forwarding header (XFF/Forwarded/X-Real-IP) being ABSENT, (2) the X-Admin-Token
# shared secret when set, and (3) the public proxy never forwarding /api/admin.
# X-Forwarded-For is NOT trusted. NEVER run uvicorn with --proxy-headers here.
ADMIN_ALLOWED_CIDRS="127.0.0.1/32,10.0.0.0/24"
# STRONGLY recommended for go-live: a shared secret required on every admin call
# via the X-Admin-Token header (defense-in-depth if the IP gate is bypassed).
# Empty = token disabled. Generate one, keep it ONLY here (gitignored .env).
ADMIN_TOKEN=""
ADMIN_REJECT_FORWARDED=true        # reject proxied admin requests (recommended)

# --- Generation queue (bounds RAM) ---
GEN_MAX_CONCURRENT=2
GEN_MAX_QUEUE=8
GEN_REQUEST_TIMEOUT=180.0
GEN_QUEUE_POLL_SECONDS=0.5

# --- Serving-layer thread budget (advisory) ---
# Hard guarantee is a CPUAffinity/cpuset on the inference process (see deploy/).
MODEL_MAX_THREADS=32

# --- Jailbreak / prompt-injection containment (public endpoint) ---
# In-house input+output guard on top of the structural no-tools guarantee.
JAILBREAK_GUARD_ENABLED=true
# Operator-specific tokens to REDACT from model output (real public IP / hostname /
# provider / location words). Keep OUT of any committed file; set ONLY here in the
# gitignored .env at deploy. Comma-separated. The structural guarantees already stop
# the model from KNOWING these; this is belt-and-suspenders.
GUARD_REDACT_TERMS=""

# --- Mermaid server-side rendering (OFF = zero server-side exec) ---
# When false the backend runs NO subprocess for any chat/skill request; the
# frontend renders Mermaid client-side. Only enable on a trusted/internal deploy.
MERMAID_RENDER_ENABLED=false

# --- Seeding ---
SEED_ON_STARTUP=true

# --- CORS ---
# Comma-separated origins allowed to call the API from a browser.
# Default is safe for local development. Override for any deployed frontend:
#   Demo on example.com:  CORS_ALLOW_ORIGINS="https://chat.example.com"
#   Open public demo:          CORS_ALLOW_ORIGINS="*"
CORS_ALLOW_ORIGINS="http://localhost:8000,http://localhost:3000"
