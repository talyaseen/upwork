# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).
#
# These are the project URL and the public "anon" key. Both are safe to expose
# to the browser (they are protected by Row Level Security). NEVER put the
# service_role key in this file or anywhere client-side.
#
# The app runs WITHOUT these set - it falls back to bundled illustrative demo
# data so you can preview the UI immediately. Set them to connect a real
# Supabase project (auth + saved collections require it).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: enables the one-click "Try the live demo" button on /login, which
# signs in to a pre-seeded, pre-confirmed demo account. These are SERVER-ONLY
# (no NEXT_PUBLIC_ prefix) and are never exposed to the browser or committed.
# Set them in your hosting provider's environment (e.g. Vercel). Leave unset to
# hide the demo button gracefully.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=set-in-your-host-environment
